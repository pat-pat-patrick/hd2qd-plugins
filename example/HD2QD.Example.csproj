<Project Sdk="Microsoft.NET.Sdk">

  <!-- HD2QD.Example.dll: the example plugin (docs/plugin-authors.md). .NET Framework 4.8, as the
       manager; the file name must be HD2QD.<name>.dll. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HD2QD.Example</AssemblyName>
    <RootNamespace>Hd2Qd.Example</RootNamespace>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- the text, one file per language (Lang\<tag>.json), embedded as Lang.<tag>.json: Words.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
